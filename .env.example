# Template only; never commit real secrets.
# Node.js 22.12+; build: npm run build:timeweb; launch: npm start.
# Public Cloud configuration is required BEFORE building and visible in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Matching public Cloud settings for authenticated server functions.
# Do not copy a sandbox-local server address to Timeweb.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
HOST=0.0.0.0
PORT=3000

# BLOCKERS, NOT SECRET VALUES TO COPY:
# SUPABASE_SERVICE_ROLE_KEY is managed and unavailable for export from Lovable Cloud.
# LOVABLE_API_KEY is automatically managed; do not request or manually configure it.
# TELEGRAM_API_KEY_1 is a Lovable connector credential, not a BotFather token.
# LOVABLE_CRON_SECRET / LOVABLE_CRON_SECRET_PREVIOUS belong to managed scheduled calls.
# Current privileged, AI and Telegram handlers need a separately approved
# external integration/migration before a full external release is possible.